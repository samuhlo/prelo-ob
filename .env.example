MARGEN_TOKEN=replace-with-a-long-random-token
MARGEN_BIND=127.0.0.1
MARGEN_PORT=8765
# Study publications work without AI. Set codex-bridge to opt in on your Mac.
AI_PROVIDER=disabled
CODEX_BRIDGE_URL=http://host.docker.internal:8766
# For AI_PROVIDER=compatible, configure the Chat Completions provider here.
# With codex-bridge, AI_MODEL may be left empty to use the CLI default.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional per stage: the plan needs judgement and is short; writing is many
# smaller calls. Empty values fall back to AI_MODEL / AI_EFFORT.
# Effort: minimal, low, medium, high (or xhigh where the model supports it).
# Codex example: AI_MODEL=sol-6.1, AI_EFFORT_PLAN=high, AI_EFFORT_WRITE=medium.
AI_MODEL_PLAN=
AI_MODEL_WRITE=
AI_EFFORT=
AI_EFFORT_PLAN=
AI_EFFORT_WRITE=
# Parallel calls, characters per chunk and seconds allowed per call.
AI_CONCURRENCY=2
AI_CHUNK_CHARS=20000
AI_TIMEOUT=600
